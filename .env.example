# ============================================================================
# Variables de NotificacionesANM en el VPS.
# Copiar como .env en la raíz del repo (/opt/apps/NotificacionesANM/.env)
# y proteger:  chmod 600 .env     ← NUNCA subirlo a GitHub
# DB_PATH, PORT y TZ los fija docker-compose.yml: no hace falta ponerlos aquí.
# ============================================================================

# --- Dominio público (sslip.io: la IP del VPS con guiones, sin tocar DNS) ---
# Debe coincidir con ANM_DOMINIO de /opt/proxy/.env. Con él se registra el webhook de Telegram
# y se arman los enlaces al panel en los correos.
PUBLIC_DOMAIN=anm.203-0-113-10.sslip.io

# --- Correo por SMTP de Gmail ---
EMAIL_SENDER=tu_cuenta@gmail.com
# Contraseña de APLICACIÓN de Google (16 letras; requiere verificación en 2 pasos).
# NO es la contraseña normal de la cuenta. Los espacios se quitan solos.
EMAIL_PASSWORD=abcd efgh ijkl mnop
# Destinatarios separados por coma
EMAIL_RECEIVER=correo_del_tio@gmail.com
# Opcionales
# EMAIL_SENDER_NAME=Sistema de Monitoreo Minero ANM
# ALERTAS_EMAIL=tu_correo@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Acceso al panel ---
ADMIN_USER=
ADMIN_PASSWORD=
PANEL_USER=
PANEL_PASSWORD=
# Recomendado: una cadena larga aleatoria (openssl rand -hex 32)
SESSION_SECRET=

# --- Telegram ---
TG_CLIENTE_TOKEN=
TG_CLIENTE_CHATS=
TG_ADMIN_TOKEN=
TG_ADMIN_CHAT=
# TG_WEBHOOK_SECRET=

# --- healthchecks.io (URL de ping o solo el UUID) ---
HC_BARRIDO_SEMANA=
HC_BARRIDO_DOMINGO=
HC_LATIDO=

# --- Resumen con IA (opcional) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_POR_BARRIDO=25

# --- Reglas de negocio (opcionales, con sus valores por defecto) ---
# FECHA_MINIMA_ALERTAS=2025-06-01
# FUENTE_COACTIVO=true
# DIAS_FIJACION_AVISO=5
# DIAS_RECURSO=10
# DIAS_COACTIVO=15
# UMBRALES_RECORDATORIO=5,3,1,0
# DIAS_SIN_BARRIDO_OK=3
